{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "grafana-cloud-vending-machine",
      "changelog-sections": [
        {"type": "feat", "section": "Features"},
        {"type": "fix", "section": "Bug Fixes"},
        {"type": "perf", "section": "Performance Improvements"},
        {"type": "revert", "section": "Reverts"},
        {"type": "docs", "section": "Documentation"},
        {"type": "style", "section": "Styles", "hidden": true},
        {"type": "chore", "section": "Miscellaneous Chores"},
        {"type": "refactor", "section": "Code Refactoring"},
        {"type": "test", "section": "Tests", "hidden": true},
        {"type": "build", "section": "Build System"},
        {"type": "ci", "section": "Continuous Integration", "hidden": true}
      ],
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "pull-request-title-pattern": "chore: release ${version}",
      "pull-request-header": "Migration guidance: [0.x to 1.0](https://github.com/rknightion/grafana-cloud-vending-machine/blob/main/docs/migration-1.0.md). Review the required request changes before applying the 1.0.0 candidate."
    }
  }
}
